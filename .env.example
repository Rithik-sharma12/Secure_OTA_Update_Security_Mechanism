# SentinelOTA — environment template
#
#   cp .env.example .env    then fill in every REQUIRED value.
#
# Nothing here has a working default any more. Values that used to fall back to
# a literal in the repository (the gateway API key, the admin password) are now
# required, because a default credential published in a public repo is not a
# credential.

# ── REQUIRED: gateway write authentication ───────────────────────────────
# Guards every state-mutating gateway endpoint, firmware publishing included.
# Generate with:  openssl rand -hex 32
# The same value goes into the firmware's BACKEND_API_KEY.
OTA_GATEWAY_API_KEY=

# Set to true ONLY on a trusted local network to run the gateway with no write
# authentication at all. The gateway refuses to start with an empty API key
# unless this is set.
OTA_GATEWAY_ALLOW_OPEN_WRITES=

# ── REQUIRED: dashboard admin bootstrap ──────────────────────────────────
# Minimum 12 characters; demo/default values are rejected at startup.
OTA_ADMIN_USERNAME=
OTA_ADMIN_PASSWORD=
OTA_SESSION_TTL_HOURS=

# ── Gateway ──────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the gateway. '*' is honoured
# but disables credentialed requests.
OTA_GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OTA_GATEWAY_SIGNING_KEY_ID=
OTA_GATEWAY_RELEASE_ARTIFACT=

# ── Remote device control ────────────────────────────────────────────────
# true (default): every healthy device installs the newest compatible release
# on its own. false: devices only install what a dashboard deployment assigns.
OTA_AUTO_UPDATE=true
# Once every board has been provisioned with its own device token
# (Devices -> Provision over USB), set this to true so the shared fleet key
# can no longer be used to speak for those boards.
OTA_REQUIRE_DEVICE_TOKEN=false
# Commands queued from the dashboard expire if the device does not pick them up.
OTA_COMMAND_TTL_MINUTES=30
# History kept on the gateway (SQLite next to the firmware cache).
OTA_TELEMETRY_RETENTION_DAYS=7
OTA_AUDIT_MAX_ROWS=50000

# ── GitHub release -> gateway (POST /api/github/webhook) ────────────────
# Create a webhook on the repository: payload URL https://<gateway>/api/github/webhook,
# content type application/json, event "Releases", and this secret.
OTA_GITHUB_WEBHOOK_SECRET=
# owner/name allowed to publish firmware through the webhook.
OTA_GITHUB_REPOSITORY=
# Only for private repositories (asset download).
OTA_GITHUB_TOKEN=
# release asset -> board type, comma separated.
OTA_GITHUB_ASSET_MAP=firmware-esp32.bin=ESP32
# Optional: lets the gateway decrypt and RSA-verify each CI package exactly as
# a device would before publishing it.
OTA_RELEASE_AES_KEY=
OTA_RELEASE_RSA_PUBKEY_PATH=

# Dashboard compile-and-flash refuses any other ESP32 Arduino core version
# (matches platformio.ini). "any" disables the check.
OTA_ESP32_CORE_VERSION=2.0.17

# The gateway address written into boards during USB provisioning. Defaults to
# OTA_GATEWAY_PUBLIC_URL. Must be reachable from the boards' network.
OTA_DEVICE_GATEWAY_URL=

# ── URLs ─────────────────────────────────────────────────────────────────
OTA_LOCAL_URL=
OTA_PUBLIC_URL=

# ── Runtime command execution (disabled in production unless set) ────────
# Leave OTA_RUNTIME_COMMANDS_ENABLED empty unless you need shell access from
# the dashboard; it executes commands on the host running the IDE.
OTA_RUNTIME_COMMANDS_ENABLED=
OTA_RUNTIME_COMMAND_ALLOWLIST=
OTA_RUNTIME_COMMAND_TOKEN=

# ── Deployment ───────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
DOCKERHUB_USER=
IMAGE_TAG=

# ── Supabase Auth ─────────────────────────────────────────────────────────
# The dashboard uses Supabase Auth for sign-in and sessions when both values
# are set. Create dashboard users in Supabase Authentication -> Users.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk Authentication ─────────────────────────────────────────────────
# The dashboard uses Clerk for sign-in, sign-up and sessions when both values
# are set. Never expose CLERK_SECRET_KEY to browser code.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
