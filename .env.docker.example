# Secure_OTA container deployment configuration
# Copy this file to .env.docker before running compose commands.

# OTA_IDE credentials
OTA_ADMIN_USERNAME=secure-ota-admin
# Quote the value if it contains # or spaces
OTA_ADMIN_PASSWORD="Secure_OTA_College_2026!"
OTA_SESSION_TTL_HOURS=24

# Shared gateway auth key (used by OTA_IDE and gateway write APIs)
OTA_GATEWAY_API_KEY=CHANGE_ME_GATEWAY_API_KEY
OTA_GATEWAY_PUBLIC_URL=http://localhost:5000
OTA_GATEWAY_SIGNING_KEY_ID=gateway-ed25519-primary
OTA_GATEWAY_RELEASE_ARTIFACT=

# Runtime command hardening
OTA_RUNTIME_COMMANDS_ENABLED=false
OTA_RUNTIME_COMMAND_TOKEN=
OTA_RUNTIME_COMMAND_ALLOWLIST=echo,dir,ls,pwd,whoami,node,python,py

# Docker Hub deployment variables
DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=latest
