# SentinelOTA Container Deployment Configuration
# Copy this file to .env.docker before running docker compose up commands.

# ------------------------------------------------------------------------------
# Dashboard Authentication & Credentials
# ------------------------------------------------------------------------------
OTA_ADMIN_USERNAME=secure-ota-admin
# CHANGE THIS. Must be >= 12 characters and not a default/demo value — the
# dashboard refuses to start otherwise. Quote it if it contains special
# characters, and never include a literal '$' (compose interpolates it).
# NOTE: this only bootstraps the admin on FIRST start. If a user already
# exists in the .local-db volume, changing it here has no effect.
OTA_ADMIN_PASSWORD="CHANGE_ME_to_a_long_random_passphrase"
OTA_SESSION_TTL_HOURS=24

# ------------------------------------------------------------------------------
# Gateway Configuration & API Security
# ------------------------------------------------------------------------------
# Shared key between Gateway write endpoints and OTA IDE Dashboard.
# CHANGE THIS. Generate a URL-safe key (it is also accepted as ?api_key=):
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
OTA_GATEWAY_API_KEY=CHANGE_ME_generate_a_random_url_safe_key
# Address DEVICES use to download firmware. Which one applies is decided by the
# compose file you deploy with, NOT by editing these:
#   docker-compose.local.yml  ->  uses OTA_LOCAL_URL   (LAN, plain HTTP)
#   docker-compose.cloud.yml  ->  uses OTA_PUBLIC_URL  (internet, HTTPS)
# Both must be reachable from the DEVICE — never localhost.
OTA_LOCAL_URL=http://CHANGE_ME_LAN_IP:5000
OTA_PUBLIC_URL=https://CHANGE_ME_PUBLIC_HOSTNAME
OTA_GATEWAY_SIGNING_KEY_ID=gateway-ed25519-primary
OTA_GATEWAY_RELEASE_ARTIFACT=

# ------------------------------------------------------------------------------
# Remote Shell & Runtime Command Execution Guardrails
# ------------------------------------------------------------------------------
OTA_RUNTIME_COMMANDS_ENABLED=false
OTA_RUNTIME_COMMAND_TOKEN=
OTA_RUNTIME_COMMAND_ALLOWLIST=echo,dir,ls,pwd,whoami,node,python,py


# ------------------------------------------------------------------------------
# Cloudflare Tunnel (optional — public access for the dashboard)
# ------------------------------------------------------------------------------
# Token from Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > Install.
# Leave empty unless you run docker-compose.cloudflare.yml.
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# Supabase Database Configuration (Optional Cloud DB)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ------------------------------------------------------------------------------
# Docker Image Build & Tagging
# ------------------------------------------------------------------------------
DOCKERHUB_USER=sentinel-ota
IMAGE_TAG=latest
